# DB (Railway MySQL)
DB_URL=jdbc:mysql://<host>:<port>/<database>?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# 이미지 저장소 (Cloudinary 대시보드의 API Environment variable 값)
# 형식: cloudinary://<api_key>:<api_secret>@<cloud_name>
# 비워두면 업로드가 비활성화되어 채팅 사진 전송이 실패한다
CLOUDINARY_URL=

# API 문서(Swagger). 운영에서는 반드시 false 로 둔다.
SWAGGER_ENABLED=false

# App Store 심사관용 체험 로그인 (/v1/auth/demo)
# 심사 기간에만 true 로 두고, 통과 후 false 로 내려 엔드포인트를 닫는다.
# DEMO_LOGIN_KEY 를 채우면 해당 키를 X-Demo-Key 헤더로 보낸 클라이언트만 허용한다.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_KEY=
